# Optional but strongly recommended: a free Hugging Face token (read scope) from
# https://huggingface.co/settings/tokens . Without it the anonymous ZeroGPU limit is a handful of runs.
HF_TOKEN=
# Paid, best results, no daily cap (~$0.03-0.04 per image): key from https://fal.ai/dashboard/keys
FAL_KEY=
# default: fal-nano-banana when FAL_KEY is set, otherwise qwen-fast
# fal-nano-banana | fal-qwen-edit | qwen-fast | qwen-official | none
TRYON_PROVIDER=
# local (default, runs BiRefNet on this machine) | space (Hugging Face Space)
BIREFNET_BACKEND=local
